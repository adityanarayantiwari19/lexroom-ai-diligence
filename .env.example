# Optional. Without a key, the app uses deterministic demo answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional persistent vector index. Configure both to enable pgvector retrieval.
DATABASE_URL=
OPENAI_API_KEY=

# Set a stable random secret in production to keep signed room cookies valid across restarts.
ROOM_SESSION_SECRET=
